# Copie para .env e ajuste os valores
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=sua_senha_mysql
DB_NAME=ppsig_curitiba

# Tamanho do pool de conexões (aumente para mais usuários simultâneos)
DB_POOL_SIZE=16

# Gere uma chave forte: python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET=troque-esta-chave-em-producao

# ── Produção / site público ──
# Domínio do frontend se estiver separado (deixe vazio se Flask serve o front)
# ALLOWED_ORIGIN=https://meusite.com

# Rate limiting compartilhado entre workers (use Redis em produção)
# RATELIMIT_STORAGE_URI=redis://default:senha@host:porta

# Bloqueio anti-spam por dispositivo (CUIDADO em redes compartilhadas)
# ENABLE_FINGERPRINT_BLOCK=1

PORT=5000
